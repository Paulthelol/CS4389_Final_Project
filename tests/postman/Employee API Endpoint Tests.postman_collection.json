  "item": [
    {
      "name": "Teller Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Teller login successful\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const data = pm.response.json();\r",
              "\r",
              "pm.test(\"Teller token exists\", () => {\r",
              "    pm.expect(data.session_token).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.environment.set(\"teller_token\", data.session_token);\r",
              "pm.environment.set(\"teller_id\", data.employee.employee_id);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employee_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "R{\r\n    \"username\": \"teller1\",\r\n    \"password\": \"teller1\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/employees/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "employees",
            "login"
          ]
        }
      },
      "response": []
    },
