{
  "name": "Mock Banking App - React, Python & PostgreSQL",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/banking-app",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    }
  },
  "forwardPorts": [5173, 4173, 5000],
  "portsAttributes": {
    "5173": { "label": "Vite React", "onAutoForward": "notify" },
    "4173": { "label": "Vite preview", "onAutoForward": "silent" },
    "5000": { "label": "Flask API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "ms-python.python"],
      "settings": {
        "eslint.workingDirectories": ["./frontend"]
      }
    }
  }
}
